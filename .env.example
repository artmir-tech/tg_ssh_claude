# Claude Control settings. Copy to .env (chmod 600). Never commit or share .env.

# From @BotFather (/newbot). One bot per Linux account: a bot token can be used by only one service.
TELEGRAM_BOT_TOKEN=
# Telegram user id(s) allowed to control the bot, comma-separated.
OWNER_IDS=
# The forum supergroup id (-100...). Can be left empty: an owner's /start in the group binds it.
TELEGRAM_CHAT_ID=

# Parallel Claude runs. Each takes ~300-400 MB RAM; lower it if several systems share the server.
MAX_CONCURRENT_RUNS=5
# Folder for new sessions (the VS Code workspace folder, so sessions show up there) and the /project choices.
DEFAULT_CWD=/home/USER
PROJECT_DIRS=/home/USER
# Permissions for sessions (each topic can change it: «🛡 Разрешения» in its panel):
#   auto        - like «Auto» in VS Code: Claude Code's safety check approves routine work, risky actions are
#                 blocked or asked in Telegram (Opus/Sonnet; with Haiku Claude simply asks)
#   acceptEdits - file edits in the working folder without asking, commands are asked
#   default     - ask for every command and edit
# bypassPermissions is never used, whatever is written here.
PERMISSION_MODE=auto
# Tools Claude may use without asking in any mode.
AUTO_ALLOW_TOOLS=WebSearch,WebFetch
# Unanswered permission requests are denied after this many minutes.
PERMISSION_TIMEOUT_MIN=60
# Times shown in Telegram (IANA name).
TIMEZONE=Asia/Tbilisi
# Voice messages -> text (GigaAM v3, Russian). Needs ffmpeg and ~1.7 GB disk; the model takes ~1.6 GB RAM
# while in use and is unloaded after 5 idle minutes. Set to gigaam to enable (then run deploy/install.sh).
VOICE_ENGINE=
# Longer recordings are not transcribed.
VOICE_MAX_MIN=15
# File size limits (Telegram Bot API: 50 MB from the bot, 20 MB to the bot). With your own Bot API server
# (TELEGRAM_API_BASE, --local mode) both can go up to 2000.
MAX_SEND_MB=50
MAX_RECEIVE_MB=20
